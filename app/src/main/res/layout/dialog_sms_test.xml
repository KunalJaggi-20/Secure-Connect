<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_message"
                android:background="@drawable/bg_tool_icon_indigo"
                android:padding="8dp"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMS Scam Simulator"
                    android:textColor="#1F2937"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test live detection &amp; floating HUD overlay"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:rotation="180"
                android:background="@drawable/bg_icon_ripple"
                android:padding="6dp"
                app:tint="#6B7280" />
        </LinearLayout>

        <!-- Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK PRESETS (TAP TO LOAD):"
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPresetBank"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🏦 Bank KYC"
                    android:textSize="11sp"
                    android:backgroundTint="#FEE2E2"
                    android:textColor="#DC2626"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPresetElectricity"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="⚡ Power Cut"
                    android:textSize="11sp"
                    android:backgroundTint="#FEF3C7"
                    android:textColor="#D97706"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPresetLottery"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🎁 KBC Lottery"
                    android:textSize="11sp"
                    android:backgroundTint="#EDE9FE"
                    android:textColor="#6366F1"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPresetSafe"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🟢 Safe Bank OTP"
                    android:textSize="11sp"
                    android:backgroundTint="#DCFCE7"
                    android:textColor="#16A34A" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Sender Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sender ID / Phone Number:"
            android:textColor="#374151"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etTestSender"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="+919876543210 or VK-SBIINB"
            android:textColor="#1F2937"
            android:textSize="13sp"
            android:background="@drawable/edittext_bg"
            android:paddingHorizontal="14dp"
            android:singleLine="true" />

        <!-- Message Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message Body to Analyze:"
            android:textColor="#374151"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etTestMessage"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top|start"
            android:hint="Paste or enter SMS content here..."
            android:textColor="#1F2937"
            android:textSize="13sp"
            android:background="@drawable/edittext_bg"
            android:padding="12dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnTriggerPopup"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🚨 Live HUD Popup"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnAnalyzeLog"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🔍 Analyze &amp; Save"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#155B83"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Result Box -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#F9FAFB">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴 CRITICAL RISK"
                        android:textColor="#DC2626"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:background="@drawable/bg_risk_critical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                    <TextView
                        android:id="@+id/txtResultScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Score: 85/100"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtResultCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bank &amp; KYC Phishing Scam"
                    android:textColor="#1F2937"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtResultExplanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Explanation here..."
                    android:textColor="#4B5563"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtResultTriggers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Triggers: kyc, pan card, bit.ly"
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
